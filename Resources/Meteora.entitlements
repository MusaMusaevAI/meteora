<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox: the app can only touch files the user explicitly opens or saves. -->
	<key>com.apple.security.app-sandbox</key><true/>
	<!-- Files picked in Open/Save panels, dragged in, or opened from Finder. -->
	<key>com.apple.security.files.user-selected.read-write</key><true/>
	<!-- ~/Downloads/Meteora: where handed-off audio is placed. -->
	<key>com.apple.security.files.downloads.read-write</key><true/>
	<!-- Meeting journal: reopen a recording the user already opened, without
	     asking again (read-only bookmarks, only for those files). Recorder:
	     one read-write bookmark for the folder the user picked for new
	     recordings. Auto-folders: one read-write bookmark per folder the
	     user picked in the Open panel (e.g. Documents/Телемост). -->
	<key>com.apple.security.files.bookmarks.app-scope</key><true/>
	<!-- Required by WebKit in a sandboxed app: without it the web content
	     process is killed and video can't be shown. The page itself can't
	     reach the network: CSP forbids it, the navigation policy allows only
	     the bundled player page, a content blocker drops every non
	     meteora-media:// request, and the app contains no networking code. -->
	<key>com.apple.security.network.client</key><true/>
	<!-- Meeting recording (Recording/): the microphone, AirPods, USB mics and
	     an iPhone via Continuity through AVCaptureSession, and the system-audio
	     tap. Only used while the user records; macOS asks once
	     (NSMicrophoneUsageDescription, NSAudioCaptureUsageDescription) and
	     shows its orange indicator. Audio is written only to the folder the
	     user chose; nothing is sent anywhere. -->
	<key>com.apple.security.device.audio-input</key><true/>
	<!-- Deliberately absent: network server, camera, Apple Events, JIT,
	     unsigned executable memory, library validation exceptions. -->
</dict>
</plist>
