<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox: the app can only touch files the user explicitly opens or saves. -->
	<key>com.apple.security.app-sandbox</key><true/>
	<!-- Files picked in Open/Save panels, dragged in, or opened from Finder. -->
	<key>com.apple.security.files.user-selected.read-write</key><true/>
	<!-- ~/Downloads/Meteora: where audio for MacWhisper is placed. -->
	<key>com.apple.security.files.downloads.read-write</key><true/>
	<!-- Required by WebKit in a sandboxed app: without it the web content
	     process is killed and video can't be shown. The page itself can't
	     reach the network: CSP forbids it, the navigation policy allows only
	     the bundled player page, a content blocker drops every non
	     meteora-media:// request, and the app contains no networking code. -->
	<key>com.apple.security.network.client</key><true/>
	<!-- Deliberately absent: network server, camera, microphone, Apple Events,
	     JIT, unsigned executable memory, library validation exceptions. -->
</dict>
</plist>
